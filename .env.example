# =========================================================
# Intra-Chat configuration
# Copy this file to `.env` and edit the values. Never commit `.env`.
# =========================================================

# --- Authentication (required) ---------------------------------------------
# Login password for the chat. `python setup_password.py` writes both this
# and SECRET_KEY for you.
APP_PASSWORD=change_me_to_a_long_passphrase

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_random_64_hex_chars

# --- Server -----------------------------------------------------------------
# Host/port the Flask-SocketIO server binds to.
HOST=0.0.0.0
PORT=5656

# Maximum failed login attempts before lockout, and lockout duration (ms).
MAX_ATTEMPTS=5
LOCK_MS=30000

# --- Storage paths ----------------------------------------------------------
# Where uploaded files are stored. Defaults to `<repo>/uploads`.
# Set to a shared/team folder if you want everyone to write to the same place.
UPLOAD_FOLDER=

# Optional: extra directory of Markdown files to surface in /docs and /manual.
# Leave blank to disable team docs.
TEAM_DOCS_PATH=

# --- AI engine (Ollama) -----------------------------------------------------
# Used by the /summarize chat command. If Ollama isn't running the command
# will degrade gracefully with an explanatory message.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

# --- Logging ----------------------------------------------------------------
# Set to 1 to write upload/auth debug logs to disk.
DEBUG_LOGS=0
